# Only submission files belong at the repository root.
/*
!/package.json
!/package-lock.json
!/tsconfig.json
!/next.config.ts
!/next-env.d.ts
!/postcss.config.mjs
!/compose.yaml
!/.env.example
!/.gitignore
!/.gitattributes
!/README.md
!/src/
!/scripts/

# Secrets, generated output and local development state.
.env*
!/.env.example
node_modules/
.next/
.cache/
.local/
.playwright*/
output/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
*.log
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db

# Agent instructions, private notes and source attachments are not deliverables.
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]*
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]*
[Gg][Ee][Mm][Ii][Nn][Ii].[Mm][Dd]*
.agents/
.codex/
.claude/
.cursor/
.vscode/
.idea/
*.docx
*.srt
*.vtt

# Only review screenshots belong in docs.
!/docs/
/docs/*
!/docs/screenshots/
